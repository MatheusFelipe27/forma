{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    // "nodenext" + `"type": "commonjs"` no package.json = emissão CommonJS com
    // a resolução moderna do Node (respeita o campo "exports" dos pacotes, que
    // "moduleResolution": "node10" — o default de "module": "commonjs" — ignora).
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },

  // O build compila apenas a aplicação (rootDir: ./src). `prisma/seed.ts` é um
  // script de desenvolvimento executado via tsx e não entra no dist — sem este
  // include ele seria capturado pelo padrão '**/*' e quebraria o rootDir.
  "include": ["src"],
}
